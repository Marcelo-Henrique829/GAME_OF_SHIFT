// Centraliza a lógica dos painéis neste evento do controlador.
with (obj_panel)
{
    // index pertence ao painel atual; other referencia o controlador.
    switch (index)
    {
        case 0:
            // Reserve aqui a lógica dos painéis com index 0.
            break;

        default:
            // Outros índices permanecem sem comportamento por enquanto.
            break;
    }
}
